{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "model/Dockerfile",
    "watchPatterns": ["model/**"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 1200,
    "restartPolicyType": "ON_FAILURE"
  }
}
